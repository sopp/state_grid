# 复制成 .env 后填真值；.env 里全是凭证，不要提交、chmod 600
SGCC_ACCOUNT=13800000000
SGCC_PASSWORD=改成你自己的
# 备用标识：主标识被拒时 run_once.sh 只换它试一次
SGCC_EMAIL_ACCOUNT=you@example.com

# 集成首启时在 HA 日志里打出来的那一串（warning 级：这台容器只放 WARNING 以上）
HA_WEBHOOK_URL=http://172.16.1.7:8123
HA_WEBHOOK_TOKEN=填HA日志里的那串id

# 点选验证码的视觉解算，走 OpenAI 兼容接口
SGCC_LLM_KEY=ark-xxxxxxxx
SGCC_LLM_BASE=https://ark.cn-beijing.volces.com/api/plan/v3
SGCC_LLM_MODEL=doubao-seed-2.1-lite

# 可留空走默认值
# SGCC_BASE=https://95598.cn
# SGCC_PAGES=/electricityCharge?partNo=P02021703,/paymentRecord
# SGCC_RUN_AT=07:10
# SGCC_RETRY_MIN=60
